{
  "realm": "laboratorio",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "SUPER-ADMIN-ROLE",
        "description": "Administrador: puede hacer todo",
        "composite": true,
        "composites": {
          "realm":["USER"]
        }
      },
      {
        "name": "USER",
        "description": "Usuario estandar"
      }
    ]
  },
  "clients": [
    {
      "clientId": "laboratorio-api",
      "name": "API del laboratorio (Spring Boot)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*", "https://oauth.pstmn.io/v1/callback"],
      "webOrigins": ["+"],
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@laboratorio.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["SUPER-ADMIN-ROLE"]
    },
    {
      "username": "usuario",
      "enabled": true,
      "email": "usuario@laboratorio.local",
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Usuario",
      "credentials": [{ "type": "password", "value": "usuario123", "temporary": false }],
      "realmRoles": ["USER"]
    }
  ]
}